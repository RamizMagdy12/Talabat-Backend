@{
    var placeholder = ViewData["SearchPlaceholder"] as string ?? "Search...";
    var value = ViewData["Search"] as string ?? "";
    var action = ViewData["SearchAction"] as string;
    var controller = ViewData["SearchController"] as string;
}
<form method="get"
      asp-action="@(action ?? "Index")"
      asp-controller="@controller"
      class="search-bar">
    <input type="search"
           name="q"
           value="@value"
           class="form-control"
           placeholder="@placeholder"
           autocomplete="off" />
    <button type="submit" class="btn btn-brand">Search</button>
    @if (!string.IsNullOrWhiteSpace(value))
    {
        <a class="btn btn-outline-secondary" asp-action="@(action ?? "Index")" asp-controller="@controller">Clear</a>
    }
</form>
