@using System.Globalization
@using System.Security.Claims
@{
    var isAuth = User?.Identity?.IsAuthenticated == true;
    var path = Context.Request.Path.Value ?? "";
    var isRtl = L.IsRtl;
    var uiLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@uiLang" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @L["admin.brand"]</title>
    <meta name="theme-color" content="#ff4d00" />
    <link rel="icon" href="~/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg?v=2" />
    <link rel="icon" type="image/png" href="~/favicon-32.png?v=2" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Manrope:wght@400;500;600;700;800&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @if (isRtl)
    {
        <style>
            :root {
                --font-display: "Cairo", "Segoe UI", Tahoma, sans-serif;
                --font-body: "Cairo", "Segoe UI", Tahoma, sans-serif;
            }
            body { font-family: var(--font-body); }
            .sidebar { border-right: 0; border-left: 1px solid rgba(255,255,255,.06); }
        </style>
    }
</head>
<body>
@if (isAuth)
{
    <div class="admin-shell" id="adminShell">
        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>
        <aside class="sidebar" id="adminSidebar">
            <div class="sidebar-brand">
                <span class="brand-mark">T</span>
                <div>
                    <strong>@L["admin.brand"]</strong>
                    <small>@L["admin.brandSub"]</small>
                </div>
                <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Close menu">&times;</button>
            </div>
            <nav class="sidebar-nav">
                <a class="nav-link @(path.StartsWith("/Dashboard") || path == "/" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">@L["admin.nav.dashboard"]</a>
                <a class="nav-link @(path.StartsWith("/Products") ? "active" : "")" asp-controller="Products" asp-action="Index">@L["admin.nav.products"]</a>
                <a class="nav-link @(path.StartsWith("/Inventory") ? "active" : "")" asp-controller="Inventory" asp-action="Index">@L["admin.nav.inventory"]</a>
                <a class="nav-link @(path.StartsWith("/Brands") ? "active" : "")" asp-controller="Brands" asp-action="Index">@L["admin.nav.brands"]</a>
                <a class="nav-link @(path.StartsWith("/Categories") ? "active" : "")" asp-controller="Categories" asp-action="Index">@L["admin.nav.categories"]</a>
                <a class="nav-link @(path.StartsWith("/Orders") ? "active" : "")" asp-controller="Orders" asp-action="Index">@L["admin.nav.orders"]</a>
                <a class="nav-link @(path.StartsWith("/Offers") ? "active" : "")" asp-controller="Offers" asp-action="Index">@L["admin.nav.offers"]</a>
                <a class="nav-link @(path.StartsWith("/Accounts") ? "active" : "")" asp-controller="Accounts" asp-action="Index">@L["admin.nav.users"]</a>
                <a class="nav-link @(path.StartsWith("/Finance") ? "active" : "")" asp-controller="Finance" asp-action="Index">@L["admin.nav.finance"]</a>
            </nav>
            <div class="sidebar-footer">
                <div class="user-chip">@User.FindFirstValue(ClaimTypes.Email)</div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm w-100">@L["admin.logout"]</button>
                </form>
            </div>
        </aside>
        <main class="main-panel">
            <header class="topbar">
                <button type="button" class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-controls="adminSidebar" aria-expanded="false">
                    <span></span><span></span><span></span>
                </button>
                <div>
                    <h1>@ViewData["Title"]</h1>
                    <p class="text-muted mb-0">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
                </div>
                <form class="lang-switch-form" asp-controller="Language" asp-action="Set" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                    <input type="hidden" name="culture" value="@(uiLang == "ar" ? "en" : "ar")" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        @(uiLang == "ar" ? L["lang.en"] : L["lang.ar"])
                    </button>
                </form>
            </header>

            @if (TempData["Success"] != null)
            {
                <div class="admin-alert admin-alert--ok" role="status">
                    <span class="admin-alert__mark" aria-hidden="true">✓</span>
                    <div>
                        <strong>@L["admin.success"]</strong>
                        <p>@TempData["Success"]</p>
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="admin-alert admin-alert--err" role="alert">
                    <span class="admin-alert__mark" aria-hidden="true">!</span>
                    <div>
                        <strong>@L["admin.error"]</strong>
                        <p>@TempData["Error"]</p>
                    </div>
                </div>
            }

            <div class="content-wrap">
                @RenderBody()
            </div>
        </main>
    </div>
}
else
{
    <main class="auth-wrap">
        @RenderBody()
    </main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
(() => {
  const shell = document.getElementById('adminShell');
  if (!shell) return;
  const toggle = document.getElementById('menuToggle');
  const closeBtn = document.getElementById('sidebarClose');
  const backdrop = document.getElementById('sidebarBackdrop');
  const setOpen = (open) => {
    shell.classList.toggle('sidebar-open', open);
    if (toggle) toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  };
  toggle?.addEventListener('click', () => setOpen(!shell.classList.contains('sidebar-open')));
  closeBtn?.addEventListener('click', () => setOpen(false));
  backdrop?.addEventListener('click', () => setOpen(false));
  shell.querySelectorAll('.sidebar-nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
