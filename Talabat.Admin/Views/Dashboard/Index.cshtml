@using Talabat.Admin.Helpers
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="dash-hero">
    <div class="dash-hero__copy">
        <p class="dash-kicker">Talabat Admin</p>
        <h2>Operations overview</h2>
        <p class="dash-hero__sub">Track inventory, order flow, and delivery status in one place.</p>
    </div>
    <div class="dash-hero__actions">
        <a class="btn btn-brand" asp-controller="Offers" asp-action="Index">Manage offers</a>
        <a class="btn btn-outline-dark" asp-controller="Products" asp-action="Create">Add product</a>
        <a class="btn btn-outline-dark" asp-controller="Orders" asp-action="Index">Manage orders</a>
    </div>
</section>

<div class="stat-grid">
    <article class="stat-card brand">
        <div class="stat-card__icon" aria-hidden="true">P</div>
        <div>
            <div class="label">Products</div>
            <div class="value">@Model.TotalProducts</div>
        </div>
    </article>
    <article class="stat-card warn">
        <div class="stat-card__icon" aria-hidden="true">!</div>
        <div>
            <div class="label">Low Stock (≤10)</div>
            <div class="value">@Model.LowStockCount</div>
        </div>
    </article>
    <article class="stat-card danger">
        <div class="stat-card__icon" aria-hidden="true">%</div>
        <div>
            <div class="label">Active Offers</div>
            <div class="value">@Model.ActiveOffers</div>
        </div>
    </article>
    <article class="stat-card ok">
        <div class="stat-card__icon" aria-hidden="true">T</div>
        <div>
            <div class="label">Orders Today</div>
            <div class="value">@Model.OrdersToday</div>
        </div>
    </article>
</div>

<section class="pipeline-panel">
    <div class="panel-header">
        <div>
            <h2>Order pipeline</h2>
            <p class="panel-sub">Live status breakdown</p>
        </div>
    </div>
    <div class="pipeline-grid">
        <div class="pipeline-card">
            <span class="pipeline-card__label">Pending</span>
            <strong>@Model.PendingOrders</strong>
        </div>
        <div class="pipeline-card pipeline-card--paid">
            <span class="pipeline-card__label">Paid</span>
            <strong>@Model.PaidOrders</strong>
        </div>
        <div class="pipeline-card pipeline-card--prep">
            <span class="pipeline-card__label">Preparing</span>
            <strong>@Model.PreparingOrders</strong>
        </div>
        <div class="pipeline-card pipeline-card--ship">
            <span class="pipeline-card__label">Out for delivery</span>
            <strong>@Model.OutForDeliveryOrders</strong>
        </div>
        <div class="pipeline-card pipeline-card--done">
            <span class="pipeline-card__label">Delivered</span>
            <strong>@Model.DeliveredOrders</strong>
        </div>
    </div>
</section>

<div class="panel">
    <div class="panel-header">
        <div>
            <h2>Recent orders</h2>
            <p class="panel-sub">Latest customer activity</p>
        </div>
        <a class="btn btn-sm btn-brand" asp-controller="Orders" asp-action="Index">View all</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Buyer</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.RecentOrders.Any())
            {
                <tr><td colspan="6" class="text-muted">No orders yet.</td></tr>
            }
            else
            {
                foreach (var order in Model.RecentOrders)
                {
                    <tr>
                        <td><strong class="order-id">#@order.Id</strong></td>
                        <td>@order.BuyerEmail</td>
                        <td>@order.OrderDate.ToLocalTime().ToString("g")</td>
                        <td>
                            <span class="badge-status @OrderStatusHelper.BadgeClass(order.Status)">
                                @OrderStatusHelper.DisplayName(order.Status)
                            </span>
                        </td>
                        <td class="money-cell">@order.GetTotal().ToString("C")</td>
                        <td><a class="table-link" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Details</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
