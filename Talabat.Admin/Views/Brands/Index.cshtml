@model IReadOnlyList<ProductBrand>
@{
    ViewData["Title"] = "Brands";
    ViewData["Search"] = ViewBag.Search as string;
    ViewData["SearchPlaceholder"] = "Search brands...";
}

<div class="panel">
    <div class="panel-header">
        <h2>All Brands</h2>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <partial name="_SearchBar" />
            <a class="btn btn-brand btn-sm" asp-action="Create">Add Brand</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th style="width:180px">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var brand in Model)
            {
                <tr>
                    <td>@brand.Id</td>
                    <td>@brand.Name</td>
                    <td class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@brand.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@brand.Id" method="post" onsubmit="return confirm('Delete this brand?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
