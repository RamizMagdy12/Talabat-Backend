@model ProductBrand
@{
    ViewData["Title"] = L["admin.brands.edit"];
}

<div class="panel" style="max-width:560px">
    <div class="panel-header"><h2>@L["admin.brands.edit"] #@Model.Id</h2></div>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label">@L["admin.brands.nameEn"]</label>
            <input asp-for="Name" class="form-control" placeholder="@L["admin.products.nameEnPh"]" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NameAr" class="form-label">@L["admin.brands.nameAr"]</label>
            <input asp-for="NameAr" class="form-control" dir="rtl" placeholder="@L["admin.products.nameArPh"]" />
            <span asp-validation-for="NameAr" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-brand">@L["admin.common.update"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@L["admin.common.cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
