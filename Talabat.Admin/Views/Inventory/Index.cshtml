@model InventoryIndexViewModel
@{
    ViewData["Title"] = L["admin.inventory.title"];
    ViewData["Search"] = Model.Search;
    ViewData["SearchPlaceholder"] = L["admin.inventory.search"];
}

<div class="stat-grid">
    <div class="stat-card brand">
        <div class="label">@L["admin.inventory.products"]</div>
        <div class="value">@Model.TotalSkus</div>
    </div>
    <div class="stat-card ok">
        <div class="label">@L["admin.inventory.unitsRemaining"]</div>
        <div class="value">@Model.UnitsRemaining</div>
    </div>
    <div class="stat-card">
        <div class="label">@L["admin.inventory.unitsAdded"]</div>
        <div class="value">@Model.UnitsAdded</div>
    </div>
    <div class="stat-card warn">
        <div class="label">@L["admin.inventory.unitsSold"]</div>
        <div class="value">@Model.UnitsSold</div>
    </div>
    <div class="stat-card danger">
        <div class="label">@L["admin.inventory.lowStock"]</div>
        <div class="value">@Model.LowStockCount</div>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <h2>@L["admin.inventory.ledger"]</h2>
        <span class="text-muted" style="font-size:.85rem">@L["admin.inventory.added"] / @L["admin.inventory.sold"] / @L["admin.inventory.remaining"]</span>
    </div>
    <partial name="_SearchBar" />
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>@L["admin.nav.products"]</th>
                    <th>@L["admin.inventory.added"]</th>
                    <th>@L["admin.inventory.lastIn"]</th>
                    <th>@L["admin.inventory.sold"]</th>
                    <th>@L["admin.inventory.lastSold"]</th>
                    <th>@L["admin.inventory.remaining"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Products.Any())
            {
                <tr><td colspan="7" class="text-muted py-4 text-center">@L["admin.inventory.none"]</td></tr>
            }
            else
            {
                foreach (var row in Model.Products)
                {
                    <tr>
                        <td>
                            <strong>@row.Name</strong>
                            <div class="text-muted" style="font-size:.8rem">
                                #@row.ProductId
                                @if (!string.IsNullOrWhiteSpace(row.Brand))
                                {
                                    <span>· @row.Brand</span>
                                }
                                @if (!row.IsActive)
                                {
                                    <span class="badge-status badge-failed">@L["admin.common.hidden"]</span>
                                }
                            </div>
                        </td>
                        <td><strong>@row.TotalAdded</strong></td>
                        <td class="text-muted">@(row.LastInAtUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                        <td><strong>@row.TotalSold</strong></td>
                        <td class="text-muted">@(row.LastSoldAtUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                        <td>
                            @if (row.Remaining <= 10)
                            {
                                <span class="badge-status badge-low">@row.Remaining</span>
                            }
                            else
                            {
                                @row.Remaining
                            }
                        </td>
                        <td class="text-end">
                            <a class="table-link" asp-action="Details" asp-route-id="@row.ProductId">@L["admin.inventory.history"]</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
