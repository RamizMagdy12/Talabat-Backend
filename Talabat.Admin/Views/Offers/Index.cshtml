@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Offers";
    ViewData["Search"] = ViewBag.Search as string;
    ViewData["SearchPlaceholder"] = "Search products...";
    var now = DateTime.UtcNow;
}

<div class="panel">
    <div class="panel-header">
        <div>
            <h2>Offers</h2>
            <p class="panel-sub">Set promo price and offer window for any product</p>
        </div>
        <partial name="_SearchBar" />
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Product</th>
                    <th>Regular</th>
                    <th>Offer</th>
                    <th>Window</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-muted">No products found.</td></tr>
            }
            else
            {
                foreach (var product in Model)
                {
                    var active = product.IsOfferActive(now);
                    var scheduled = product.OfferPrice.HasValue && product.OfferStartUtc.HasValue && product.OfferEndUtc.HasValue && !active && product.OfferEndUtc > now;
                    <tr>
                        <td>@product.Id</td>
                        <td><strong>@product.Name</strong></td>
                        <td>@product.Price.ToString("C")</td>
                        <td>
                            @if (product.OfferPrice.HasValue)
                            {
                                <span class="money-cell">@product.OfferPrice.Value.ToString("C")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="small">
                            @if (product.OfferStartUtc.HasValue && product.OfferEndUtc.HasValue)
                            {
                                @($"{product.OfferStartUtc.Value.ToLocalTime():g} → {product.OfferEndUtc.Value.ToLocalTime():g}")
                            }
                            else
                            {
                                <span class="text-muted">No schedule</span>
                            }
                        </td>
                        <td>
                            @if (active)
                            {
                                <span class="badge-status badge-prep">Active</span>
                            }
                            else if (scheduled)
                            {
                                <span class="badge-status badge-pending">Scheduled</span>
                            }
                            else if (product.OfferEndUtc.HasValue && product.OfferEndUtc < now)
                            {
                                <span class="badge-status badge-failed">Expired</span>
                            }
                            else
                            {
                                <span class="badge-status badge-ship">None</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-brand" asp-action="Edit" asp-route-id="@product.Id">Manage</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
