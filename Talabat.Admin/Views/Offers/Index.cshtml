@model IReadOnlyList<Product>
@{
    ViewData["Title"] = L["admin.offers.title"];
    ViewData["Search"] = ViewBag.Search as string;
    ViewData["SearchPlaceholder"] = L["admin.offers.search"];
    var now = DateTime.UtcNow;
}

<div class="panel">
    <div class="panel-header">
        <div>
            <h2>@L["admin.offers.title"]</h2>
            <p class="panel-sub">@L["admin.offers.sub"]</p>
        </div>
        <partial name="_SearchBar" />
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@L["admin.offers.product"]</th>
                    <th>@L["admin.offers.regular"]</th>
                    <th>@L["admin.offers.offer"]</th>
                    <th>@L["admin.offers.window"]</th>
                    <th>@L["admin.offers.status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-muted">@L["admin.offers.noneFound"]</td></tr>
            }
            else
            {
                foreach (var product in Model)
                {
                    var active = product.IsOfferActive(now);
                    var scheduled = product.OfferPrice.HasValue && product.OfferStartUtc.HasValue && product.OfferEndUtc.HasValue && !active && product.OfferEndUtc > now;
                    <tr>
                        <td>@product.Id</td>
                        <td><strong>@product.Name</strong></td>
                        <td>@MoneyFormat.Format(product.Price)</td>
                        <td>
                            @if (product.OfferPrice.HasValue)
                            {
                                <span class="money-cell">@MoneyFormat.Format(product.OfferPrice.Value)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="small">
                            @if (product.OfferStartUtc.HasValue && product.OfferEndUtc.HasValue)
                            {
                                @($"{product.OfferStartUtc.Value.ToLocalTime():g} → {product.OfferEndUtc.Value.ToLocalTime():g}")
                            }
                            else
                            {
                                <span class="text-muted">@L["admin.offers.noSchedule"]</span>
                            }
                        </td>
                        <td>
                            @if (active)
                            {
                                <span class="badge-status badge-prep">@L["admin.common.active"]</span>
                            }
                            else if (scheduled)
                            {
                                <span class="badge-status badge-pending">@L["admin.offers.scheduled"]</span>
                            }
                            else if (product.OfferEndUtc.HasValue && product.OfferEndUtc < now)
                            {
                                <span class="badge-status badge-failed">@L["admin.offers.expired"]</span>
                            }
                            else
                            {
                                <span class="badge-status badge-ship">@L["admin.common.none"]</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-brand" asp-action="Edit" asp-route-id="@product.Id">@L["admin.offers.manage"]</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
