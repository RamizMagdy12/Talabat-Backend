@model AccountsIndexViewModel
@{
    ViewData["Title"] = L["admin.users.title"];
    ViewData["Search"] = Model.Search;
    ViewData["SearchPlaceholder"] = L["admin.users.search"];
}

<div class="stat-grid">
    <div class="stat-card brand">
        <div class="label">@L["admin.users.accounts"]</div>
        <div class="value">@Model.TotalAccounts</div>
    </div>
    <div class="stat-card warn">
        <div class="label">@L["admin.users.ordersToday"]</div>
        <div class="value">@Model.OrdersToday</div>
    </div>
    <div class="stat-card ok">
        <div class="label">@L["admin.users.ordersMonth"]</div>
        <div class="value">@Model.OrdersThisMonth</div>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <h2>@L["admin.users.all"]</h2>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <partial name="_SearchBar" />
            <a class="btn btn-brand btn-sm" asp-action="Create">@L["admin.users.createBtn"]</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>@L["admin.users.name"]</th>
                    <th>@L["admin.users.email"]</th>
                    <th>@L["admin.users.phone"]</th>
                    <th>@L["admin.users.roles"]</th>
                    <th>@L["admin.users.today"]</th>
                    <th>@L["admin.users.thisMonth"]</th>
                    <th>@L["admin.users.totalOrders"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Accounts.Any())
            {
                <tr><td colspan="8" class="text-muted">@L["admin.users.none"]</td></tr>
            }
            else
            {
                foreach (var account in Model.Accounts)
                {
                    var isPanel = account.Roles.Contains(AdminRoles.Admin) || account.Roles.Contains(AdminRoles.Staff);
                    <tr>
                        <td>@account.DisplayName</td>
                        <td>@account.Email</td>
                        <td>@(account.PhoneNumber ?? "-")</td>
                        <td>
                            @if (account.Roles.Any())
                            {
                                foreach (var role in account.Roles)
                                {
                                    <span class="badge-status badge-paid">@role</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">@L["admin.users.customer"]</span>
                            }
                        </td>
                        <td>@account.OrdersToday</td>
                        <td>@account.OrdersThisMonth</td>
                        <td><strong>@account.TotalOrders</strong></td>
                        <td class="text-end">
                            @if (isPanel)
                            {
                                <a class="table-link" asp-action="EditPermissions" asp-route-id="@account.Id">@L["admin.users.editPermissions"]</a>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
