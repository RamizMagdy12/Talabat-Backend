@using Talabat.Admin.Helpers
@model IReadOnlyList<Order>
@{
    ViewData["Title"] = L["admin.nav.orders"];
    ViewData["Search"] = ViewBag.Search as string;
    ViewData["SearchPlaceholder"] = L["admin.orders.search"];
    var selectedStatus = ViewBag.Status as OrderStatus?;
}

<div class="panel">
    <div class="panel-header">
        <h2>@L["admin.orders.all"]</h2>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <form method="get" class="search-bar">
                <input type="search" name="q" value="@ViewBag.Search" class="form-control" placeholder="@L["admin.orders.search"]" />
                <select name="status" class="form-select" style="min-width:180px">
                    <option value="">@L["admin.orders.allStatuses"]</option>
                    @foreach (OrderStatus st in Enum.GetValues(typeof(OrderStatus)))
                    {
                        if (selectedStatus == st)
                        {
                            <option value="@st" selected>@OrderStatusHelper.DisplayName(st)</option>
                        }
                        else
                        {
                            <option value="@st">@OrderStatusHelper.DisplayName(st)</option>
                        }
                    }
                </select>
                <button type="submit" class="btn btn-brand">@L["admin.common.search"]</button>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string) || selectedStatus.HasValue)
                {
                    <a class="btn btn-outline-secondary" asp-action="Index">@L["admin.common.clear"]</a>
                }
            </form>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@L["admin.col.buyer"]</th>
                    <th>@L["admin.col.date"]</th>
                    <th>@L["admin.col.items"]</th>
                    <th>@L["admin.col.status"]</th>
                    <th>@L["admin.col.total"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-muted">@L["admin.orders.none"]</td></tr>
            }
            else
            {
                foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.BuyerEmail</td>
                        <td>@order.OrderDate.ToLocalTime().ToString("g")</td>
                        <td>@order.Items?.Count</td>
                        <td>
                            <span class="badge-status @OrderStatusHelper.BadgeClass(order.Status)">
                                @OrderStatusHelper.DisplayName(order.Status)
                            </span>
                        </td>
                        <td>@(order.DeliveryMethod != null ? MoneyFormat.Format(order.GetTotal()) : MoneyFormat.Format(order.Subtotal))</td>
                        <td><a asp-action="Details" asp-route-id="@order.Id">@L["admin.col.details"]</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
