@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
    ViewData["Search"] = ViewBag.Search as string;
    ViewData["SearchPlaceholder"] = "Search products, brand, category...";
}

<div class="panel">
    <div class="panel-header">
        <h2>Inventory</h2>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <partial name="_SearchBar" />
            <a class="btn btn-brand btn-sm" asp-action="Create">Add Product</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name EN / AR</th>
                    <th>Brand</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Offer</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th style="width:280px">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var product in Model)
            {
                <tr class="@(product.IsActive ? "" : "table-secondary")">
                    <td>@product.Id</td>
                    <td>
                        <div>@product.Name</div>
                        @if (!string.IsNullOrWhiteSpace(product.NameAr))
                        {
                            <div class="text-muted" dir="rtl" style="font-size:.85rem">@product.NameAr</div>
                        }
                    </td>
                    <td>
                        @product.ProductBrand?.Name
                        @if (!string.IsNullOrWhiteSpace(product.ProductBrand?.NameAr))
                        {
                            <span class="text-muted"> / @product.ProductBrand!.NameAr</span>
                        }
                    </td>
                    <td>
                        @product.productCategory?.Name
                        @if (!string.IsNullOrWhiteSpace(product.productCategory?.NameAr))
                        {
                            <span class="text-muted"> / @product.productCategory!.NameAr</span>
                        }
                    </td>
                    <td>@MoneyFormat.Format(product.Price)</td>
                    <td>
                        @if (product.IsOfferActive())
                        {
                            <span class="badge-status badge-prep">@MoneyFormat.Format(product.OfferPrice!.Value)</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (product.Stock <= 10)
                        {
                            <span class="badge-status badge-low">@product.Stock</span>
                        }
                        else
                        {
                            @product.Stock
                        }
                    </td>
                    <td>
                        @if (product.IsActive)
                        {
                            <span class="badge-status badge-delivered">Active</span>
                        }
                        else
                        {
                            <span class="badge-status badge-failed">Hidden</span>
                        }
                    </td>
                    <td class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                        <a class="btn btn-sm btn-brand" asp-controller="Offers" asp-action="Edit" asp-route-id="@product.Id">Offer</a>
                        <form asp-action="ToggleActive" asp-route-id="@product.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(product.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                @(product.IsActive ? "Hide" : "Show")
                            </button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" onsubmit="return confirm('Delete this product?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
