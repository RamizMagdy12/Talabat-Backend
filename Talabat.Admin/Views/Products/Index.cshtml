@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
    ViewData["Search"] = ViewBag.Search as string;
    ViewData["SearchPlaceholder"] = "Search products, brand, category...";
}

<div class="panel">
    <div class="panel-header">
        <h2>Inventory</h2>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <partial name="_SearchBar" />
            <a class="btn btn-brand btn-sm" asp-action="Create">Add Product</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Brand</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th style="width:180px">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.ProductBrand?.Name</td>
                    <td>@product.productCategory?.Name</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>
                        @if (product.Stock <= 10)
                        {
                            <span class="badge-status badge-low">@product.Stock</span>
                        }
                        else
                        {
                            @product.Stock
                        }
                    </td>
                    <td class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" onsubmit="return confirm('Delete this product?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
