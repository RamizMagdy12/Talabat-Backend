@model ProductFormViewModel
@{
    ViewData["Title"] = L["admin.products.edit"];
}

<div class="panel" style="max-width:720px">
    <div class="panel-header"><h2>@L["admin.products.edit"] #@Model.Id</h2></div>
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <partial name="_ProductForm" model="Model" />
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-brand">@L["admin.common.update"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@L["admin.common.cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
