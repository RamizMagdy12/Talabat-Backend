@model LoginViewModel
@{
    ViewData["Title"] = L["admin.login.title"];
    Layout = "_Layout";
}

<div class="login-stage">
    <div class="login-orb login-orb-a"></div>
    <div class="login-orb login-orb-b"></div>
    <div class="login-orb login-orb-c"></div>
    <div class="login-grid"></div>

    <div class="login-card">
        <h1>@L["admin.login.heading"]</h1>
        <p class="subtitle">@L["admin.login.sub"]</p>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label">@L["admin.login.email"]</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">@L["admin.login.password"]</label>
                <div class="password-field">
                    <input asp-for="Password" class="form-control" id="loginPassword" autocomplete="current-password" />
                    <button type="button" class="password-toggle" data-target="loginPassword" aria-label="@L["admin.common.showPassword"]">👁</button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">@L["admin.login.remember"]</label>
            </div>
            <button type="submit" class="btn btn-brand w-100">@L["admin.login.submit"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
