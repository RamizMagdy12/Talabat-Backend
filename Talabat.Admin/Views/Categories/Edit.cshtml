@model ProductCategory
@{
    ViewData["Title"] = "Edit Category";
}

<div class="panel" style="max-width:560px">
    <div class="panel-header"><h2>Edit Category #@Model.Id</h2></div>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name (English)</label>
            <input asp-for="Name" class="form-control" placeholder="English name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NameAr" class="form-label">Name (Arabic)</label>
            <input asp-for="NameAr" class="form-control" dir="rtl" placeholder="الاسم بالعربي" />
            <span asp-validation-for="NameAr" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-brand">Update</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
