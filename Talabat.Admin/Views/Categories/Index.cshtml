@model IReadOnlyList<ProductCategory>
@{
    ViewData["Title"] = L["admin.categories.title"];
    ViewData["Search"] = ViewBag.Search as string;
    ViewData["SearchPlaceholder"] = L["admin.categories.search"];
}

<div class="panel">
    <div class="panel-header">
        <h2>@L["admin.categories.all"]</h2>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <partial name="_SearchBar" />
            <a class="btn btn-brand btn-sm" asp-action="Create">@L["admin.categories.add"]</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>@L["admin.common.id"]</th>
                    <th>@L["admin.brands.nameEn"]</th>
                    <th>@L["admin.brands.nameAr"]</th>
                    <th style="width:180px">@L["admin.common.actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td dir="rtl">@(string.IsNullOrWhiteSpace(category.NameAr) ? "—" : category.NameAr)</td>
                    <td class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id">@L["admin.common.edit"]</a>
                        <form asp-action="Delete" asp-route-id="@category.Id" method="post" onsubmit="return confirm('@L["admin.categories.deleteConfirm"]');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">@L["admin.common.delete"]</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
